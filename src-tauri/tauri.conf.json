{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvCompass",
  "version": "0.1.0",
  "identifier": "dev.envcompass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EnvCompass",
        "width": 1040,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "EnvCompass contributors",
    "homepage": "https://github.com/XiaojuCH/EnvCompass",
    "copyright": "Copyright © 2026 EnvCompass contributors",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Find why your project won't run.",
    "longDescription": "A Windows-first, local-first development environment doctor with privacy-safe reports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
